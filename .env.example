# =============================================================================
# EKAA Environment Configuration Template (.env.example)
# Single Source of Truth for Environment Variables (§12, §16, §17, §30)
# =============================================================================

# App & Deployment
APP_NAME=EKAA
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://localhost
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (PostgreSQL 17 + pgvector 0.8)
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ekaa
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_ROOT_PASSWORD_HERE

# Schema Specific DB Credentials (DEC-007, Least Privilege)
DB_CORE_USERNAME=ekaa_core
DB_CORE_PASSWORD=YOUR_CORE_PASSWORD_HERE

DB_CONNECTOR_USERNAME=ekaa_connector
DB_CONNECTOR_PASSWORD=YOUR_CONNECTOR_PASSWORD_HERE

DB_AI_USERNAME=ekaa_ai
DB_AI_PASSWORD=YOUR_AI_PASSWORD_HERE

# Cache, Rate Limit, & Queue (Valkey: DEC-035)
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=YOUR_VALKEY_PASSWORD_HERE
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie

# Object Storage (SeaweedFS S3 API: DEC-034)
S3_ENDPOINT=http://objectstore:8333
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY_HERE
S3_SECRET_KEY=YOUR_S3_SECRET_KEY_HERE
S3_BUCKET_DOCUMENTS=ekaa-documents
S3_BUCKET_DATASETS=ekaa-datasets
S3_REGION=us-east-1

# Antivirus Scanner (ClamAV: DEC-038)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Service JWT Keys (Asymmetric: DEC-030)
JWT_CORE_PRIVATE_KEY_PATH=/var/ekaa/keys/core_private.pem
JWT_CORE_PUBLIC_KEY_PATH=/var/ekaa/keys/core_public.pem
JWT_AI_PUBLIC_KEY_PATH=/var/ekaa/keys/ai_public.pem
JWT_CONNECTOR_PUBLIC_KEY_PATH=/var/ekaa/keys/connector_public.pem

# AI Service Settings
AI_API_URL=http://ai-api:8000
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=BAAI/bge-m3
LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-model
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=YOUR_LLM_API_KEY_HERE

# CodeIgniter Connector Settings
CONNECTOR_API_URL=http://connector:8080
CONNECTOR_ENC_KEY=YOUR_HEX_SODIUM_KEY_HERE
