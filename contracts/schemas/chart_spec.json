{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EKAAChartSpec",
  "description": "JSON Whitelist Chart Specification (§28.4, DEC-041). Enforces deterministic visualization without script execution.",
  "type": "object",
  "required": ["type", "title", "series"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["line", "bar", "pie", "scatter"]
    },
    "title": {
      "type": "string",
      "maxLength": 255
    },
    "subtitle": {
      "type": "string",
      "maxLength": 255
    },
    "unit": {
      "type": "string",
      "maxLength": 64
    },
    "x_axis": {
      "type": "object",
      "required": ["name", "categories"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "categories": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 }
        }
      }
    },
    "y_axis": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "data"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 128 },
          "data": {
            "type": "array",
            "items": { "type": "number" }
          }
        }
      }
    }
  }
}
